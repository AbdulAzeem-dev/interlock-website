# Copy to .env.local and fill these in before publishing the site or relying on
# the RFQ form in production. Until the webhook is configured, the form saves
# a local inquiry brief instead of claiming that a message was delivered.

# Public company details
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_FACTORY_CITY=
NEXT_PUBLIC_FACTORY_ADDRESS=

# Webhook endpoint the RFQ form POSTs a JSON payload to (e.g. a Zapier/Make
# webhook, an internal API route, or an email-forwarding service).
RFQ_WEBHOOK_URL=
RFQ_WEBHOOK_TOKEN=
