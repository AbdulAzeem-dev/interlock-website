# Copy to .env.local and fill in before relying on the RFQ form in production.
# Without this set, submissions are logged server-side only (see src/lib/actions.ts).

# Webhook endpoint the RFQ form POSTs a JSON payload to (e.g. a Zapier/Make
# webhook, an internal API route, or an email-forwarding service).
RFQ_WEBHOOK_URL=
